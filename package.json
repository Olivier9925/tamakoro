{
  "name": "tamakoro",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.22",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:release": "expo run:ios --configuration Release",
    "ios:release:device": "expo run:ios --configuration Release --device",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:release": "expo run:android --variant release",
    "android:release:device": "expo run:android --variant release --device",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:ios": "expo prebuild -p ios",
    "prebuild:android": "expo prebuild -p android",
    "prebuild:clean": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "credentials:ios": "npx eas-cli@latest credentials:configure-build --platform ios --profile production",
    "build:dev": "npx eas-cli@latest build --profile development",
    "build:preview": "npx eas-cli@latest build --profile preview",
    "build:prod": "npx eas-cli@latest build --profile production",
    "build:ios:local": "npx eas-cli@latest build --profile production --platform ios --local",
    "build:sim:local": "npx eas-cli@latest build --profile simulator --platform ios --local",
    "build:testflight": "npx eas-cli@latest build --profile production --platform ios --auto-submit",
    "submit:ios": "npx eas-cli@latest submit -p ios --latest",
    "submit:testflight": "npx eas-cli@latest submit -p ios --latest --profile production",
    "localBuild:ios": "expo prebuild --platform ios && expo run:ios --configuration Release",
    "test": "node --test tests/*.test.cjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
