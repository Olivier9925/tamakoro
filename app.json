{
  "expo": {
    "name": "Tamakoro – Virtual Pet",
    "slug": "tamakoro-virtual-pet",
    "owner": "olivier9925",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/tamakoro-icon-v2.png",
    "scheme": "tamakoro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/tamakoro-icon-v2.png",
      "bundleIdentifier": "com.olivier9925.tamakoro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/tamakoro-icon-v2.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tamakoro-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#a9d875",
          "defaultChannel": "tamakoro-reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090f18",
          "image": "./assets/images/tamakoro-splash-logo.png",
          "imageWidth": 280,
          "ios": {
            "image": "./assets/images/tamakoro-splash.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover"
          }
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "3862ae69-f19a-49b0-b30a-22adc0d09f56"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
