{
  "expo": {
    "name": "Tamakoro – Virtual Pet",
    "slug": "tamakoro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tamakoro-icon-v2.png",
    "scheme": "tamakoro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/tamakoro-icon-v2.png",
      "bundleIdentifier": "com.olivier9925.tamakoro"
    },
    "android": {
      "icon": "./assets/images/tamakoro-icon-v2.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tamakoro-icon-v2.png"
    },
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#a9d875", "defaultChannel": "tamakoro-reminders" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
